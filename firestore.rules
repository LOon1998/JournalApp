rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules.
//
// Everything for one person lives in a single document at
// users/{uid}/state/data (see lib/services/cloud_sync_service.dart) — this
// rule is what actually makes it private: only a signed-in user whose auth
// uid matches the {uid} in the path can read or write their own document.
// Nobody else's request.auth.uid will ever match, so there's no way for one
// account to see another's journal.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
