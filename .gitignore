# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local Flutter SDK checkout (this machine's PATH points here — never commit
# a ~2GB copy of the SDK into the repo).
/flutter/
devtools_options.yaml

# This machine's own Gemini API key, passed to local `flutter build` runs
# via --dart-define-from-file so it doesn't have to be retyped into
# Settings after every reinstall. Never committed — same reasoning as the
# GEMINI_API_KEY GitHub Actions secret the web deploy workflow uses
# instead, just for local builds.
/local.env.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
